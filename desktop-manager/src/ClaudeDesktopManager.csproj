<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows app on .NET Framework 4.8, which every Windows 10 (1903+) / 11 already has:
    a single small exe, nothing to install. Builds on Windows or Linux:
      dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ClaudeDesktopManager</AssemblyName>
    <RootNamespace>ClaudeDesktopManager</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Claude Desktop 管理器</Product>
    <AssemblyTitle>Claude Desktop 管理器</AssemblyTitle>
    <Description>启动、关闭和管理 Claude Desktop（非官方工具）</Description>
    <Copyright>MIT License</Copyright>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
